# Use Node.js LTS (Long Term Support) image as base
FROM node:23-slim

# Set working directory
WORKDIR /app

# Copy package files
COPY ./doc-updater/package*.json ./

#COPY ./doc-updater/.env.production .env 

# Install dependencies
RUN npm install

# Copy source code
COPY ./doc-updater/ .

# Build TypeScript code
RUN npm run build

# Expose port (adjust if your app uses a different port)
EXPOSE 3002

# Start the application
CMD ["mintlify", "dev"] 