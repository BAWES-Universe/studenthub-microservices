
# docker 

## Build the image
docker build -t linear-api .

## Run the container
docker run -p 3002:3002 -d linear-api

# pm2 


## delete pm2
pm2 delete linear-api   

## start pm2
pm2 start main.ts --name 'linear-api' --interpreter 'node --loader ts-node/esm'

## restart pm2
pm2 restart linear-api

